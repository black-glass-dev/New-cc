 uint i=gl_GlobalInvocationID.x;if(i>=m.count) return;vec3 v=source[i].rgb;float l=y709(v);uint x=i%m.width,col=min(x*m.columns/m.width,m.columns-1u),wave=m.bins*m.columns,grid=m.bins*m.bins;
