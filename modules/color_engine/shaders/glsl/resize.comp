#version 450
#extension GL_GOOGLE_include_directive : require
#define float4 vec4
#define RESIZE_ARG
#define RM(i) matrix[i]
#define RS(x,y) source[(y)*sw+(x)]
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer Source { vec4 source[]; };
layout(std430,binding=1) writeonly buffer Result { vec4 output_pixels[]; };
layout(std430,binding=2) readonly buffer Matrix { float matrix[]; };
layout(push_constant) uniform Meta { uint sw,sh,dw,dh; } m;
#include "../common/resize.inc"
void main() {uint i=gl_GlobalInvocationID.x;if(i>=m.dw*m.dh) return;output_pixels[i]=resize_pixel(i%m.dw,i/m.dw,m.sw,m.sh);}
