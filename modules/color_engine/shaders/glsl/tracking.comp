#version 450
#extension GL_GOOGLE_include_directive : require
#define float2 vec2
#define float3 vec3
#define float4 vec4
#define KLT_ARG
#define KLT_PASS
#define KLT_READ(x,y,first) ((first)?previous[(y)*width+(x)]:current[(y)*width+(x)])
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer Previous { vec4 previous[]; };
layout(std430,binding=1) readonly buffer Current { vec4 current[]; };
layout(std430,binding=2) readonly buffer Features { vec4 features[]; };
layout(std430,binding=3) writeonly buffer Tracks { vec4 tracks[]; };
layout(push_constant) uniform Meta { uint width,height,count,radius,iterations;float max_error,convergence;uint reserved; } m;
#include "../common/math.inc"
#include "../common/tracking.inc"
void main() { uint i=gl_GlobalInvocationID.x;if(i>=m.count) return;tracks[i]=klt_track(features[i],m.width,m.height,m.radius,m.iterations,m.max_error,m.convergence); }
