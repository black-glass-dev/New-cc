#version 450
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer Source { vec4 source[]; };
layout(std430,binding=1) readonly buffer Blur { float horizontal[]; };
layout(std430,binding=2) writeonly buffer Result { vec4 output_pixels[]; };
layout(std430,binding=3) writeonly buffer Tmp { float output_horizontal[]; };
layout(push_constant) uniform Meta { uint width,height,radius,phase;float threshold,amount; } m;
void main() {
 uint i=gl_GlobalInvocationID.x;if(i>=m.width*m.height) return;
 int x=int(i%m.width),y=int(i/m.width);float sigma=max(1.0,float(m.radius)/2.0),sum=0.0,value=0.0;
 for(int k=-int(m.radius);k<=int(m.radius);++k) {
  float w=exp(-float(k*k)/(2.0*sigma*sigma));sum+=w;
  if(m.phase==0u) { int xx=clamp(x+k,0,int(m.width)-1);value+=max(dot(source[uint(y)*m.width+uint(xx)].rgb,vec3(.2126,.7152,.0722))-m.threshold,0.0)*w; }
  else { int yy=clamp(y+k,0,int(m.height)-1);value+=horizontal[uint(yy)*m.width+uint(x)]*w; }
 }
 if(m.phase==0u) output_horizontal[i]=value/sum;
 else output_pixels[i]=source[i]+vec4(value/sum*m.amount*vec3(1,.25,0),0);
}
